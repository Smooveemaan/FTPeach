{
  "name": "master",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash", "rebase"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "checks / changes",
            "integration_id": 15368
          },
          {
            "context": "checks / supply-chain",
            "integration_id": 15368
          },
          {
            "context": "checks / sast",
            "integration_id": 15368
          },
          {
            "context": "checks / lint-test-build",
            "integration_id": 15368
          },
          {
            "context": "checks / parser-regressions",
            "integration_id": 15368
          },
          {
            "context": "checks / rust-test",
            "integration_id": 15368
          },
          {
            "context": "checks / rust-coverage",
            "integration_id": 15368
          },
          {
            "context": "checks / visual-regression",
            "integration_id": 15368
          },
          {
            "context": "checks / packaged-smoke",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
