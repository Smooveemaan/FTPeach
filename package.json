{
  "name": "ftpeach",
  "productName": "FTPeach",
  "version": "0.1.0",
  "description": "A lightweight FTP/FTPS/SFTP/WebDAV client for Windows with a peach-toned interface",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command dev",
    "dev:tauri": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:simulate-dpapi-failure": "set FTPEACH_SIMULATE_DPAPI_FAILURE=1&& powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command dev",
    "build": "vite build && node --experimental-strip-types scripts/checks/check-bundle-budget.ts",
    "build:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command build",
    "build:tauri:raw": "tauri build",
    "rust:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command cargo-build",
    "rust:build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command cargo-build -Profile release",
    "rust:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command check",
    "rust:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command test",
    "rust:clippy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command clippy",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --experimental-strip-types --test \"test/unit/**/*.test.ts\"",
    "test:components": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "eslint . --max-warnings 0 && node --experimental-strip-types scripts/checks/check-feature-boundaries.ts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:release-config": "node --experimental-strip-types scripts/checks/check-release-config.ts",
    "licenses:generate": "node --experimental-strip-types scripts/release/generate-third-party-notices.ts",
    "licenses:check": "node --experimental-strip-types scripts/release/generate-third-party-notices.ts --check",
    "check:tracked-secrets": "node --experimental-strip-types scripts/checks/check-tracked-secrets.ts",
    "check:rust-advisories": "node --experimental-strip-types scripts/checks/check-rust-advisory-policy.ts",
    "check:no-cyrillic": "node --experimental-strip-types scripts/checks/check-no-cyrillic.ts",
    "check:rust-boundaries": "node --experimental-strip-types scripts/checks/check-rust-boundaries.ts",
    "check:duplicates": "jscpd src --threshold 2 --min-tokens 60",
    "i18n:check": "node --experimental-strip-types scripts/checks/check-locales.ts",
    "check:suite-coverage": "node --experimental-strip-types scripts/checks/check-suite-coverage.ts",
    "check": "npm run check:suite-coverage && npm run check:release-config && npm run licenses:check && npm run check:tracked-secrets && npm run check:rust-advisories && npm run check:no-cyrillic && npm run check:rust-boundaries && npm run check:duplicates && npm run i18n:check && npm test && npm run lint && npm run format:check && npm run build && npm run test:visual && cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check && npm run rust:clippy && npm run rust:test && npm run test:updater-fixtures",
    "i18n:sync": "node --experimental-strip-types scripts/i18n/i18n-deepl-sync.ts",
    "benchmark:frontend": "node --experimental-strip-types scripts/benchmarks/benchmark-frontend.ts",
    "build:packaged-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command smoke-build",
    "test:packaged-smoke": "node --experimental-strip-types scripts/packaged-smoke/smoke.ts",
    "test:updater-fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-libsodium.ps1 -Command verify-updater",
    "sbom:generate": "node --experimental-strip-types scripts/release/generate-sbom.ts",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:transfer-history": "node --experimental-strip-types scripts/benchmarks/benchmark-transfer-history.ts",
    "benchmark:transfer-ui": "node --experimental-strip-types scripts/benchmarks/benchmark-transfer-ui.ts"
  },
  "author": "Smooveemaan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smooveemaan/ftpeach.git"
  },
  "homepage": "https://github.com/Smooveemaan/ftpeach#readme",
  "bugs": {
    "url": "https://github.com/Smooveemaan/ftpeach/issues"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.13",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.1.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
