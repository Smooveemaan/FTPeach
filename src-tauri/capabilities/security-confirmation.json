{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "security-confirmation",
  "description": "Isolated permissions for the trusted sensitive-operation confirmation window",
  "windows": ["security-confirmation-*"],
  "permissions": [
    "core:window:allow-set-size",
    "sensitive:allow-sensitive-confirmation-prompt",
    "sensitive:allow-sensitive-confirmation-ready",
    "sensitive:allow-respond-sensitive-confirmation"
  ]
}
